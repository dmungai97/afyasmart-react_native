{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@admin/*": [
        "./admin/*"
      ],
      "@auth": [
        "./src/auth"
      ],
      "@auth/*": [
        "./src/auth/*"
      ],
      "@onboarding": [
        "./src/onboarding"
      ],
      "@onboarding/*": [
        "./src/onboarding/*"
      ],
      "@user": [
        "./src/user"
      ],
      "@user/*": [
        "./src/user/*"
      ],
      "@affiliate": [
        "./affiliate"
      ],
      "@affiliate/*": [
        "./affiliate/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
