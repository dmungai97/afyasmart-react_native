rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"];
    }

    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
    }

    function isOwnUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasActiveSubscription() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_subscribed == true
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription_expires_at == null
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription_expires_at > request.time);
    }

    // Safety Validation Functions
    function isSafeUserCreate(userId) {
      return isOwnUser(userId)
        && request.resource.data.keys().hasOnly([
          "id",
          "name",
          "email",
          "phone",
          "role",
          "is_subscribed",
          "has_subscribed",
          "onboarding_completed",
          "subscription_plan",
          "chat_count",
          "subscription_expires_at",
          "referred_by_uid",
          "created_at",
          "updated_at"
        ])
        && request.resource.data.id == userId
        && request.resource.data.role == "user"
        && request.resource.data.is_subscribed == false
        && request.resource.data.has_subscribed == false
        && request.resource.data.subscription_plan == "free"
        && request.resource.data.chat_count == 0
        && request.resource.data.subscription_expires_at == null;
    }

    // Subscription/chat_count fields are deliberately excluded — only Cloud
    // Functions (Admin SDK, bypasses these rules) or an admin should ever set
    // them. Letting users self-write them here would let anyone grant their
    // own free subscription without paying.
    function isSafeUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwnUser(userId)
        && changed.hasOnly([
          "name",
          "phone",
          "onboarding_completed",
          "updated_at"
        ])
        && (!changed.hasAny(["onboarding_completed"])
          || request.resource.data.onboarding_completed == true);
    }

    // --- Collections ---

    match /users/{userId} {
      // Fixed recursion: Evaluate isAdmin() ONLY if the user is not reading their own document
      allow read: if request.auth != null && (request.auth.uid == userId || (!isOwnUser(userId) && isAdmin()));

      // A regular admin may edit any non-role field on any user, but only a
      // super_admin may change the role field itself — otherwise any admin
      // could promote themselves (or anyone else) straight to super_admin.
      allow update: if isSafeUserUpdate(userId)
        || (!isOwnUser(userId) && isAdmin()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
            || isSuperAdmin()));
      allow create: if isSafeUserCreate(userId) || (!isOwnUser(userId) && isAdmin());
      
      // Admins can list everyone; an affiliate can list only the users they
      // referred (the query itself must filter on referred_by_uid for this
      // to be satisfiable — Firestore rejects any broader query outright).
      allow list: if isAdmin()
        || (request.auth != null && resource.data.referred_by_uid == request.auth.uid);

      match /chatMessages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /chatLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /doctors/{doctorId} {
      allow read: if hasActiveSubscription() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /drugs/{drugId} {
      allow read: if hasActiveSubscription() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pharmacies/{pharmacyId} {
      allow read: if hasActiveSubscription() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // A user may log their own payment attempt, but only Cloud Functions (Admin
    // SDK, verified against the actual M-Pesa result) or an admin may ever mark
    // one paid — otherwise anyone could write paid:true themselves and show up
    // as fake revenue on the admin dashboard.
    function isUnpaidPaymentWrite() {
      return request.resource.data.paid != true
        && request.resource.data.status != "paid";
    }

    match /paymentRequests/{checkoutRequestId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.auth != null
          && request.resource.data.uid == request.auth.uid
          && isUnpaidPaymentWrite());
      // Even an admin can only ever move a payment to paid:true via the
      // adminReconcilePayment Cloud Function (Admin SDK, bypasses these
      // rules) — never a direct client write — because that's the only path
      // that also credits the referring affiliate's commission.
      allow update: if (isAdmin() && isUnpaidPaymentWrite())
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && isUnpaidPaymentWrite());
      allow delete: if false;
    }

    // ── Affiliate program ─────────────────────────────────────────────────
    // Enrollment (code generation), commission crediting, and payout balance
    // deductions all happen in Cloud Functions via the Admin SDK, which
    // bypasses these rules entirely. What's left here is read access for the
    // owning affiliate/admin, and admin-only writes for manual corrections
    // or payout approval.

    match /affiliates/{affiliateUid} {
      allow read: if request.auth != null && (request.auth.uid == affiliateUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Public-ish mapping from a human-readable referral code to the
    // referrer's uid — no balances or PII, just enough for registration to
    // resolve ?ref=CODE. Written only by enrollAffiliate (Admin SDK).
    match /affiliateCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /commissions/{commissionId} {
      allow read: if request.auth != null && (resource.data.affiliate_uid == request.auth.uid || isAdmin());
      allow list: if isAdmin()
        || (request.auth != null && resource.data.affiliate_uid == request.auth.uid);
      allow write: if false;
    }

    match /payoutRequests/{payoutId} {
      allow read: if request.auth != null && (resource.data.affiliate_uid == request.auth.uid || isAdmin());
      allow list: if isAdmin()
        || (request.auth != null && resource.data.affiliate_uid == request.auth.uid);
      // Created only by requestPayout (Admin SDK, balance-checked in a
      // transaction) — a direct client create could race two withdrawal
      // requests against the same available_balance.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}